team     = "team1"
env      = "prod"
vpc_cidr = "10.1.128.0/17"

eks_instance_types = ["m7g.large"] # D53: arm(m type). caller의 ami_type=AL2023_ARM_64_STANDARD와 동반.
eks_desired_size   = 3 # 가용구역 3곳에 분산 배치 (HA)
rds_instance_class = "db.t4g.small"
redis_node_type    = "cache.t4g.small"
# (보류) 도메인/Route53 — DESIGN D48, 현재 미사용. route53 모듈·domain_name 변수 제거에 따라 주석 처리.
# domain_name        = "chatguard.store"

# 🟢 실제 반영 시 본인의 공인 IP 뒤에 /32를 붙여서 주입하세요. (예: "1.2.3.4/32")
eks_public_access_cidrs = [
  "1.2.3.4/32"    
]