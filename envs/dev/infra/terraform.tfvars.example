# envs/dev/infra/terraform.tfvars.example
# 사용법: 이 파일을 terraform.tfvars로 복사 후 plan/apply.
# (terraform.tfvars 실물은 .gitignore 대상 — 커밋 금지. 여기엔 평문 네트워크 값만, 시크릿 금지.)
# 기본값이 없어 입력이 강제되는 변수만 명시(team·env·vpc_cidr·availability_zones).

team     = "team1"
env      = "dev"
vpc_cidr = "10.1.0.0/17" # dev 전용. ⚠️ prod는 10.1.128.0/17 — 절대 혼동 금지.

# D54: 서브넷·NAT를 배치할 AZ 명시 리스트. dev=2AZ(2b 제외 — 기존 토폴로지 유지).
availability_zones = ["ap-northeast-2a", "ap-northeast-2c"]
single_nat_gateway = true # D54: dev=단일 NAT(비용). prod은 false(AZ별 NAT, HA).

slack_workspace_id = "" # 슬랙 워크스페이스 고유 ID
slack_channel_id   = "" # 알람을 받을 슬랙 단톡방 채널 ID
