# envs/dev/platform-addons/terraform.tfvars.example
# 사용법: 이 파일을 terraform.tfvars로 복사 후 apply.
# Helm 차트 버전은 고정(CLAUDE.md §3 — x.y.z, >= 금지).
# ⚠️ apply 전 한 번 확인 권장:
#     helm repo add <name> <repo> && helm repo update && helm search repo <chart> --versions | head

env = "dev"

keda_chart_version             = "2.12.0" # prod tfvars와 동일
external_secrets_chart_version = "0.9.11"
aws_lbc_chart_version          = "1.7.2" # app v2.7.2 — iam/lbc-policy.json도 v2.7.2 기준
redis_exporter_chart_version   = "6.3.0" # ⚠️ prod tfvars의 0.15.0은 존재하지 않는 버전 → 6.x로 정정
